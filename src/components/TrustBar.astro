---
// ページ上部の「確認日」表示
interface Props { checkedOn?: string; }
const { checkedOn } = Astro.props;
import Icon from './Icon.astro';
---
<p class="trust-bar">
  <span class="trust-item"><Icon name="calendar" size={14} />確認日 {checkedOn ? <time datetime={checkedOn}>{checkedOn.replaceAll('-', '/')}</time> : '確認待ち'}</span>
  <span class="trust-item"><Icon name="check" size={14} />全項目に出典リンクつき</span>
</p>
