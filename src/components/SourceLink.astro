---
// 出典リンク＋「公式」「インタビュー」ラベル
interface Props { url?: string; label?: string; }
const { url, label } = Astro.props;
const kind = label === 'インタビュー' ? 'interview' : 'official';
---
{url && (
  <a class={`source source-${kind}`} href={url} target="_blank" rel="noopener noreferrer">
    <span class="source-label">{label || '公式'}</span>出典
  </a>
)}
