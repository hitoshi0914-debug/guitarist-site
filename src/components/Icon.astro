// 塗りで描くロゴ風アイコン
const FILL: Record<string, string> = {
  x: '<path d="M18.9 1.2h3.7l-8 9.2L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.5l8.6-9.8L0 1.2h7.6l5.2 6.9zM17.6 20.6h2L6.5 3.2H4.3z"/>',
  facebook: '<path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4h-3V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/>',
  tiktok: '<path d="M16.6 2c.4 2.8 2.2 4.6 5 4.8v3.4c-1.9.1-3.6-.5-5-1.5v6.6a6.6 6.6 0 1 1-6.6-6.6h.6v3.5a3.2 3.2 0 1 0 2.5 3.1V2z"/>',
};
const stroke = STROKE[name];
const fill = FILL[name];
const body = stroke ?? fill ?? STROKE.link;
---
<svg
  class={`icon ${cls}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={stroke ? 'none' : 'currentColor'}
  stroke={stroke ? 'currentColor' : 'none'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={body}
/>
