---
import Base from '../../layouts/Base.astro';
import ArtistCard from '../../components/ArtistCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import DraftBadge from '../../components/DraftBadge.astro';
import Icon from '../../components/Icon.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { artists, news } from '../../lib/data';
const featured = artists.filter((a) => a.featured === '1');
const others = artists.filter((a) => a.featured !== '1' && a.country !== '日本');
// 日本のギタリストは「日本のシュレッド・クイーン」として別に並べる
const japan = artists.filter((a) => a.featured !== '1' && a.country === '日本');
---
<Base hasEnglish={false}>
  <section class="hero">
    <p class="hero-kicker">海外の女性ギタリスト図鑑</p>
    <h1 class="hero-title">SHRED<br />QUEENS</h1>
    <p class="hero-lead">世界のステージで弾きまくる{artists.length}人を、出典つきで深掘り。</p>
    <ul class="hero-tags">
      <li><Icon name="profile" size={16} />経歴</li>
      <li><Icon name="guitar" size={16} />機材</li>
      <li><Icon name="play" size={16} />公式動画</li>
      <li><Icon name="plane" size={16} />来日情報</li>
    </ul>
  </section>

  {artists.length === 0 ? (
    <p class="empty">ただいま準備中です。</p>
  ) : (
    <section class="card-grid" aria-label="ギタリスト一覧">
      {featured.map((a) => (
        <div class="card-featured">
          <p class="featured-label"><Icon name="crown" size={18} />推し枠</p>
          <ArtistCard artist={a} size="large" />
        </div>
      ))}
      {others.map((a) => <ArtistCard artist={a} />)}
    </section>
  )}

  {japan.length > 0 && (
    <section class="section" aria-label="日本のシュレッド・クイーン">
      <SectionTitle icon="guitar" en="JAPAN">日本のシュレッド・クイーン</SectionTitle>
      <div class="card-grid">
        {japan.map((a) => <ArtistCard artist={a} />)}
      </div>
    </section>
  )}

  <AdSlot />

  <section class="entry-grid" aria-label="コンテンツ">
    <a class="entry" href="/ja/gear/"><span class="entry-icon"><Icon name="amp" size={30} /></span><span class="entry-body"><span class="entry-title">機材比較</span><span>{artists.length}人の機材を横並びで</span></span><Icon name="arrow" class="entry-arrow" /></a>
    <a class="entry" href="/ja/quiz/"><span class="entry-icon"><Icon name="quiz" size={30} /></span><span class="entry-body"><span class="entry-title">診断</span><span>あなたに合うのは誰？</span></span><Icon name="arrow" class="entry-arrow" /></a>
    <a class="entry" href="/ja/nita-street-team/"><span class="entry-icon"><Icon name="megaphone" size={30} /></span><span class="entry-body"><span class="entry-title">ストリートチーム</span><span>ニタを日本から応援</span></span><Icon name="arrow" class="entry-arrow" /></a>
  </section>

  <section class="section">
    <SectionTitle icon="bell" en="NEWS">更新情報</SectionTitle>
    {news.length === 0 ? <p class="muted">まだありません。</p> : (
      <ul class="news-list">
        {news.slice(0, 3).map((n) => (
          <li><time>{n.date.replaceAll('-', '/')}</time> {n.title_ja} <DraftBadge row={n} /></li>
        ))}
      </ul>
    )}
    <p><a class="more" href="/ja/news/">更新情報をすべて見る</a></p>
  </section>
</Base>
