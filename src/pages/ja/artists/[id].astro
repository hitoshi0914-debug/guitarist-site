---
import Base from '../../../layouts/Base.astro';
import ArtistCard from '../../../components/ArtistCard.astro';
import TrustBar from '../../../components/TrustBar.astro';
import SourceLink from '../../../components/SourceLink.astro';
import GearVideo from '../../../components/GearVideo.astro';
import GearImage from '../../../components/GearImage.astro';
import DraftBadge from '../../../components/DraftBadge.astro';
import EditorNote from '../../../components/EditorNote.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Icon from '../../../components/Icon.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import SnsLinks from '../../../components/SnsLinks.astro';
import StreetTeamBanner from '../../../components/StreetTeamBanner.astro';
import { SITE } from '../../../lib/site';
import { artists, timeline, gear, gearVideos, songs, japan, byArtist, latestCheck, GEAR_CATEGORIES, type Artist } from '../../../lib/data';

export function getStaticPaths() {
  return artists.map((artist) => ({ params: { id: artist.id }, props: { artist } }));
}
const { artist: a } = Astro.props as { artist: Artist };
const tl = byArtist(timeline, a.id).sort((x, y) => (x.year_from || '9999').localeCompare(y.year_from || '9999'));
const gr = byArtist(gear, a.id);
const gv = byArtist(gearVideos, a.id);
const sg = byArtist(songs, a.id);
const jp = byArtist(japan, a.id);
const checkedOn = latestCheck([a], tl, gr, sg, jp);
const points = a.points_ja.split('|').filter(Boolean);
const years = (f: string, t: string) => (!f ? '時期調査中' : t === f ? f : `${f}〜${t}`);
const sns = [
  ['公式サイト', a.official_site], ['Instagram', a.instagram], ['X', a.x],
  ['Facebook', a.facebook], ['YouTube', a.youtube], ['TikTok', a.tiktok],
].filter(([, url]) => url) as [string, string][];
const CAT_ICON: Record<string, string> = { guitar: 'guitar', amp: 'amp', effects: 'pedal' };
const isNita = a.id === 'nita-strauss';
// 検索でよく使われる別表記（例：ニタストラウス、Nita Strauss、Hurricane Nita）
const nameNoDot = a.name_ja.replace(/・/g, '');
const aliases = [...new Set([nameNoDot, a.name_en, a.nickname].filter((n) => n && n !== a.name_ja))];
const fullName = a.name_en && a.name_en !== a.name_ja ? `${a.name_ja}（${a.name_en}）` : a.name_ja;
const leadAliases = aliases.filter((n) => n !== a.nickname);
const pageTitle = `${fullName}｜ギタリストの経歴・使用機材・来日情報`;
const firstPoint = points[0] ? `${points[0].replace(/。$/, '')}。` : '';
const pageDescription = `${fullName}は${a.country ? `${a.country}の` : ''}ギタリスト。${firstPoint}経歴・バンド変遷・使用ギターとアンプ・おすすめ曲・来日情報を出典つきで解説します。`;
const lead = [
  `${a.name_ja}${leadAliases.length ? `（${leadAliases.join('／')}）` : ''}は、${a.country ? `${a.country}の` : ''}ギタリスト。`,
  a.nickname && `愛称は「${a.nickname}」。`,
  a.current_band && `現在の活動：${a.current_band}。`,
  a.main_guitar && `メインギター：${a.main_guitar}。`,
].filter(Boolean).join('');

// 同じバンド・ツアーに関わった人を「関連するギタリスト」として内部リンクする
const bandKey = (b: string) => b.split('「')[0].trim().toLowerCase();
const IGNORE_BANDS = new Set(['ソロ', 'youtube']);
const myBands = new Set(tl.map((t) => bandKey(t.band)).filter((b) => !IGNORE_BANDS.has(b)));
const related = artists
  .filter((o) => o.id !== a.id)
  .map((o) => ({ o, shared: [...new Set(byArtist(timeline, o.id).map((t) => bandKey(t.band)))].filter((b) => myBands.has(b)) }))
  .filter((r) => r.shared.length > 0);
const sharedLabel = (o: Artist) => {
  const names = byArtist(timeline, o.id).map((t) => t.band).filter((b) => myBands.has(bandKey(b)));
  return [...new Set(names.map((b) => b.split('「')[0].trim()))].join('・');
};
const others = artists.filter((o) => o.id !== a.id && !related.some((r) => r.o.id === o.id)).slice(0, Math.max(0, 4 - related.length));

const pageUrl = new URL(`/ja/artists/${a.id}/`, SITE.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url: pageUrl,
    name: pageTitle,
    inLanguage: 'ja',
    // Googleは日時＋タイムゾーンを求めるので、確認日（YYYY-MM-DD）を日本時間0時の形にする
    ...(/^\d{4}-\d{2}-\d{2}$/.test(checkedOn) && { dateModified: `${checkedOn}T00:00:00+09:00` }),
    mainEntity: {
      '@type': 'Person',
      name: a.name_en,
      alternateName: [a.name_ja, ...aliases.filter((n) => n !== a.name_en)],
      jobTitle: 'ギタリスト',
      description: a.bio_ja,
      ...(a.photo_url && { image: new URL(a.photo_url, SITE.url).href }),
      ...(a.country && { nationality: a.country }),
      ...(a.official_site && { url: a.official_site }),
      sameAs: sns.map(([, url]) => url).filter((u) => u !== a.official_site),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: new URL('/ja/', SITE.url).href },
      { '@type': 'ListItem', position: 2, name: a.name_ja, item: pageUrl },
    ],
  },
];
const jump = [
  ['bio', '経歴', 'profile'], ['bands', 'バンド', 'history'], ['gear', '機材', 'guitar'],
  ['songs', '動画', 'play'], ['japan', '来日', 'plane'], ['sns', 'SNS', 'link'],
];
---
<Base title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <nav class="crumbs"><a href="/ja/">トップ</a> / <span>{a.name_ja}</span></nav>

  <section class="artist-top">
    <ArtistCard artist={a} size="large" link={false} />
    <div class="artist-summary">
      <p class="kicker">{a.name_en}</p>
      <h1 class="h1">{a.name_ja} <DraftBadge row={a} /></h1>
      <p class="lead">{lead}</p>
      <TrustBar checkedOn={checkedOn} />
      <ul class="points">
        {points.map((p) => <li><Icon name="star" size={16} class="point-icon" /><span>{p}</span></li>)}
      </ul>
      <SourceLink url={a.source_url} label={a.source_label} />
      {a.photo_credit && (
        <p class="photo-credit">写真：<a href={a.photo_source_url} target="_blank" rel="noopener noreferrer">{a.photo_credit}</a>{a.photo_license && `（${a.photo_license}）`}</p>
      )}
    </div>
  </section>

  <nav class="jump" aria-label="このページの目次">
    {jump.map(([id, label, icon]) => <a href={`#${id}`}><Icon name={icon} size={18} /><span>{label}</span></a>)}
  </nav>

  {isNita && <StreetTeamBanner />}

  <AdSlot />

  <section class="section">
    <SectionTitle icon="profile" en="PROFILE" id="bio">{a.name_ja}の経歴</SectionTitle>
    <p>{a.bio_ja}</p>
  </section>

  <section class="section">
    <SectionTitle icon="history" en="HISTORY" id="bands">{a.name_ja}のバンド変遷</SectionTitle>
    {tl.length === 0 ? <p class="muted">調査中です。</p> : (
      <ol class="timeline">
        {tl.map((t) => (
          <li>
            <span class="tl-year">{years(t.year_from, t.year_to)}</span>
            <span class="tl-band">{t.band}</span>
            <span class="tl-role">{t.role_ja}</span>
            <SourceLink url={t.source_url} label={t.source_label} />
            <DraftBadge row={t} />
          </li>
        ))}
      </ol>
    )}
  </section>

  <section class="section">
    <SectionTitle icon="guitar" en="GEAR" id="gear">{a.name_ja}の使用機材</SectionTitle>
    {gr.length === 0 ? <p class="muted">調査中です。</p> : (
      <ul class="gear-cards">
        {gr.map((g) => (
          <li class="gear-card">
            <GearImage row={g} color={a.color || undefined} size="md" />
            <div class="gear-card-body">
              <span class="cat-badge"><Icon name={CAT_ICON[g.category] ?? 'guitar'} size={14} />{GEAR_CATEGORIES[g.category] ?? g.category}</span>
              <div>{g.maker_url ? <a class="gear-name" href={g.maker_url} target="_blank" rel="noopener"><strong>{g.maker}</strong> {g.item}</a> : <><strong>{g.maker}</strong> {g.item}</>}
{g.image_note && <div class="muted small">※{g.image_note}</div>} <DraftBadge row={g} /></div>
              <p class="gear-note">{g.note_ja}</p>
              <SourceLink url={g.source_url} label={g.source_label} />
            </div>
          </li>
        ))}
      </ul>
      <p class="muted small">※ 機材の写真は、使用許可をいただいたメーカーの商品画像（「画像提供」と表示）と、Wikimedia Commonsの自由に使える写真（作者・ライセンスを表示）です。写真のない機材はイメージ図です。</p>
    )}
    {gv.length > 0 && <div class="video-grid gear-videos">{gv.map((v) => <GearVideo row={v} />)}</div>}
    <p><a class="more" href="/ja/gear/">機材をほかのギタリストと比較する</a></p>
  </section>

  <AdSlot />

  <section class="section">
    <SectionTitle icon="play" en="VIDEOS" id="songs">{a.name_ja}のおすすめ曲・公式動画</SectionTitle>
    {sg.length === 0 ? <p class="muted">準備中です。公式YouTubeから選んで追加します。</p> : (
      <div class="video-grid">
        {sg.map((s) => (
          <figure class="video">
            {s.youtube_id && (
              <iframe src={`https://www.youtube-nocookie.com/embed/${s.youtube_id}`} title={s.title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            )}
            <figcaption>{s.title}{s.year && `（${s.year}）`} {s.note_ja} <SourceLink url={s.source_url} label={s.source_label} /> <DraftBadge row={s} /></figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>

  <section class="section">
    <SectionTitle icon="plane" en="IN JAPAN" id="japan">{a.name_ja}の来日情報</SectionTitle>
    {jp.length === 0 ? <p class="muted">調査中です。</p> : (
      <ul class="plain-list">
        {jp.map((j) => (
          <li><time>{j.date}</time> {j.event_ja}（{j.place_ja}） <SourceLink url={j.source_url} label={j.source_label} /> <DraftBadge row={j} /></li>
        ))}
      </ul>
    )}
  </section>

  <section class="section">
    <SectionTitle icon="link" en="OFFICIAL LINKS" id="sns">{a.name_ja}の公式SNS・リンク</SectionTitle>
    <SnsLinks links={sns} />
  </section>

  <EditorNote text={a.editor_note_ja} />

  <section class="section">
    <SectionTitle icon="star" en="RELATED" id="related">{related.length > 0 ? `${a.name_ja}と関わりのあるギタリスト` : 'ほかの女性ギタリスト'}</SectionTitle>
    <ul class="plain-list related-list">
      {related.map(({ o }) => <li><a href={`/ja/artists/${o.id}/`}>{o.name_ja}{o.name_en !== o.name_ja && `（${o.name_en}）`}</a><span class="muted small">：{sharedLabel(o)}つながり</span></li>)}
      {others.map((o) => <li><a href={`/ja/artists/${o.id}/`}>{o.name_ja}{o.name_en !== o.name_ja && `（${o.name_en}）`}</a></li>)}
    </ul>
    <p><a class="more" href="/ja/">女性ギタリスト一覧（全{artists.length}人）を見る</a></p>
  </section>

  {isNita && <StreetTeamBanner />}

  <AdSlot />
</Base>
