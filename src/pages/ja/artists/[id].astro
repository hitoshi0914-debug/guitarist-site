---
import Base from '../../../layouts/Base.astro';
import ArtistCard from '../../../components/ArtistCard.astro';
import TrustBar from '../../../components/TrustBar.astro';
import SourceLink from '../../../components/SourceLink.astro';
import GearVideo from '../../../components/GearVideo.astro';
import GearImage from '../../../components/GearImage.astro';
import DraftBadge from '../../../components/DraftBadge.astro';
import EditorNote from '../../../components/EditorNote.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Icon from '../../../components/Icon.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import SnsLinks from '../../../components/SnsLinks.astro';
import StreetTeamBanner from '../../../components/StreetTeamBanner.astro';
import { artists, timeline, gear, gearVideos, songs, japan, byArtist, latestCheck, GEAR_CATEGORIES, type Artist } from '../../../lib/data';

export function getStaticPaths() {
  return artists.map((artist) => ({ params: { id: artist.id }, props: { artist } }));
}
const { artist: a } = Astro.props as { artist: Artist };
const tl = byArtist(timeline, a.id).sort((x, y) => (x.year_from || '9999').localeCompare(y.year_from || '9999'));
const gr = byArtist(gear, a.id);
const gv = byArtist(gearVideos, a.id);
const sg = byArtist(songs, a.id);
const jp = byArtist(japan, a.id);
const checkedOn = latestCheck([a], tl, gr, sg, jp);
const points = a.points_ja.split('|').filter(Boolean);
const years = (f: string, t: string) => (!f ? '時期調査中' : t === f ? f : `${f}〜${t}`);
const sns = [
  ['公式サイト', a.official_site], ['Instagram', a.instagram], ['X', a.x],
  ['Facebook', a.facebook], ['YouTube', a.youtube], ['TikTok', a.tiktok],
].filter(([, url]) => url) as [string, string][];
const CAT_ICON: Record<string, string> = { guitar: 'guitar', amp: 'amp', effects: 'pedal' };
const isNita = a.id === 'nita-strauss';
const jump = [
  ['bio', '経歴', 'profile'], ['bands', 'バンド', 'history'], ['gear', '機材', 'guitar'],
  ['songs', '動画', 'play'], ['japan', '来日', 'plane'], ['sns', 'SNS', 'link'],
];
---
<Base title={`${a.name_ja}（${a.name_en}）`} description={`${a.name_ja}（${a.name_en}）の経歴・バンド変遷・使用機材・おすすめ曲・来日情報・公式SNSを出典つきでまとめています。`}>
  <nav class="crumbs"><a href="/ja/">トップ</a> / <span>{a.name_ja}</span></nav>

  <section class="artist-top">
    <ArtistCard artist={a} size="large" link={false} />
    <div class="artist-summary">
      <p class="kicker">{a.name_en}</p>
      <h1 class="h1">{a.name_ja} <DraftBadge row={a} /></h1>
      <TrustBar checkedOn={checkedOn} />
      <ul class="points">
        {points.map((p) => <li><Icon name="star" size={16} class="point-icon" /><span>{p}</span></li>)}
      </ul>
      <SourceLink url={a.source_url} label={a.source_label} />
      {a.photo_credit && (
        <p class="photo-credit">写真：<a href={a.photo_source_url} target="_blank" rel="noopener noreferrer">{a.photo_credit}</a>{a.photo_license && `（${a.photo_license}）`}</p>
      )}
    </div>
  </section>

  <nav class="jump" aria-label="このページの目次">
    {jump.map(([id, label, icon]) => <a href={`#${id}`}><Icon name={icon} size={18} /><span>{label}</span></a>)}
  </nav>

  {isNita && <StreetTeamBanner />}

  <AdSlot />

  <section class="section">
    <SectionTitle icon="profile" en="PROFILE" id="bio">経歴</SectionTitle>
    <p>{a.bio_ja}</p>
  </section>

  <section class="section">
    <SectionTitle icon="history" en="HISTORY" id="bands">バンド変遷</SectionTitle>
    {tl.length === 0 ? <p class="muted">調査中です。</p> : (
      <ol class="timeline">
        {tl.map((t) => (
          <li>
            <span class="tl-year">{years(t.year_from, t.year_to)}</span>
            <span class="tl-band">{t.band}</span>
            <span class="tl-role">{t.role_ja}</span>
            <SourceLink url={t.source_url} label={t.source_label} />
            <DraftBadge row={t} />
          </li>
        ))}
      </ol>
    )}
  </section>

  <section class="section">
    <SectionTitle icon="guitar" en="GEAR" id="gear">使用機材</SectionTitle>
    {gr.length === 0 ? <p class="muted">調査中です。</p> : (
      <ul class="gear-cards">
        {gr.map((g) => (
          <li class="gear-card">
            <GearImage row={g} color={a.color || undefined} size="md" />
            <div class="gear-card-body">
              <span class="cat-badge"><Icon name={CAT_ICON[g.category] ?? 'guitar'} size={14} />{GEAR_CATEGORIES[g.category] ?? g.category}</span>
              <div>{g.maker_url ? <a class="gear-name" href={g.maker_url} target="_blank" rel="noopener"><strong>{g.maker}</strong> {g.item}</a> : <><strong>{g.maker}</strong> {g.item}</>}
{g.image_note && <div class="muted small">※{g.image_note}</div>} <DraftBadge row={g} /></div>
              <p class="gear-note">{g.note_ja}</p>
              <SourceLink url={g.source_url} label={g.source_label} />
            </div>
          </li>
        ))}
      </ul>
      <p class="muted small">※ 機材の写真は、使用許可をいただいたメーカーの商品画像（「画像提供」と表示）と、Wikimedia Commonsの自由に使える写真（作者・ライセンスを表示）です。写真のない機材はイメージ図です。</p>
    )}
    {gv.length > 0 && <div class="video-grid gear-videos">{gv.map((v) => <GearVideo row={v} />)}</div>}
    <p><a class="more" href="/ja/gear/">機材をほかのギタリストと比較する</a></p>
  </section>

  <AdSlot />

  <section class="section">
    <SectionTitle icon="play" en="VIDEOS" id="songs">おすすめ曲・公式動画</SectionTitle>
    {sg.length === 0 ? <p class="muted">準備中です。公式YouTubeから選んで追加します。</p> : (
      <div class="video-grid">
        {sg.map((s) => (
          <figure class="video">
            {s.youtube_id && (
              <iframe src={`https://www.youtube-nocookie.com/embed/${s.youtube_id}`} title={s.title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            )}
            <figcaption>{s.title}{s.year && `（${s.year}）`} {s.note_ja} <SourceLink url={s.source_url} label={s.source_label} /> <DraftBadge row={s} /></figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>

  <section class="section">
    <SectionTitle icon="plane" en="IN JAPAN" id="japan">来日情報</SectionTitle>
    {jp.length === 0 ? <p class="muted">調査中です。</p> : (
      <ul class="plain-list">
        {jp.map((j) => (
          <li><time>{j.date}</time> {j.event_ja}（{j.place_ja}） <SourceLink url={j.source_url} label={j.source_label} /> <DraftBadge row={j} /></li>
        ))}
      </ul>
    )}
  </section>

  <section class="section">
    <SectionTitle icon="link" en="OFFICIAL LINKS" id="sns">公式SNS・リンク</SectionTitle>
    <SnsLinks links={sns} />
  </section>

  <EditorNote text={a.editor_note_ja} />

  {isNita && <StreetTeamBanner />}

  <AdSlot />
</Base>
