---
import Base from '../../layouts/Base.astro';
import TrustBar from '../../components/TrustBar.astro';
import SourceLink from '../../components/SourceLink.astro';
import DraftBadge from '../../components/DraftBadge.astro';
import AdSlot from '../../components/AdSlot.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { artists, shopItems, latestCheck } from '../../lib/data';

// 本番では approved の行が1つもないうちは「準備中」として検索に出さない
const ready = shopItems.length > 0;
// アフィリエイトリンクが1つでもあればページ上部に「PR」表記を出す（ステマ規制）
const hasAffiliate = shopItems.some((r) => r.affiliate_url);
const groups = artists
  .map((a) => ({ artist: a, items: shopItems.filter((r) => r.artist_id === a.id) }));

// 関税・消費税の計算例（1ドル=150円で計算した目安）
const RATE = 150;
const examplePriceUsd = 4179;
const exampleYen = examplePriceUsd * RATE;
const exampleTaxable = Math.round(exampleYen * 0.6);
const exampleTax = Math.round(exampleTaxable * 0.1);
const yen = (n: number) => n.toLocaleString('ja-JP');
---
<Base
  title="シグネチャー品の個人輸入ガイド"
  description="ニタ・ストラウス、コートニー・コックス、ブリット・ライトニングのシグネチャーギター・ピック・ワウを日本から買う方法。販売先、日本への発送、関税・消費税のめやすを出典つきでまとめます。"
  noindex={!ready}
>
  <h1 class="h1">シグネチャー品の個人輸入ガイド</h1>
  {hasAffiliate && <p class="pr-note"><span class="pr-label">PR</span>このページには広告（アフィリエイトリンク）が含まれます。リンクから購入されると、当サイトに紹介料が入ることがあります。</p>}
  <TrustBar checkedOn={latestCheck(shopItems)} />

  {!ready ? (
    <p>このページは準備中です。</p>
  ) : (
    <>
      <p>海外の女性ギタリストのシグネチャーモデルやピックは、日本の楽器店ではほとんど扱いがありません。このページでは「どこで買えるか」「日本に送ってもらえるか」「税金はいくらかかるか」を、公式サイトの情報をもとにまとめました。価格や発送条件は変わることがあるので、購入前に必ず販売ページで確認してください。</p>

      <section class="section">
        <SectionTitle icon="guitar" en="WHERE TO BUY">どこで買える？</SectionTitle>
        {groups.map(({ artist, items }) => (
          <div class="shop-group">
            <h3 class="h3"><a href={`/ja/artists/${artist.id}/`}>{artist.name_ja}</a></h3>
            {items.length === 0 ? (
              <p class="muted">シグネチャー品の発売は確認できていません（{latestCheck(shopItems).replaceAll('-', '/') || '確認待ち'}時点）。</p>
            ) : (
              <div class="table-scroll">
                <table class="table">
                  <thead><tr><th>アイテム</th><th>販売先</th><th>価格</th><th>日本への発送</th></tr></thead>
                  <tbody>
                    {items.map((r) => (
                      <tr>
                        <td>{r.item} <DraftBadge row={r} /><br /><span class="muted">{r.note_ja}</span> <SourceLink url={r.source_url} label={r.source_label} /></td>
                        <td>
                          <a href={r.affiliate_url || r.shop_url} target="_blank" rel={r.affiliate_url ? 'sponsored noopener' : 'noopener noreferrer'}>{r.shop_name}</a>
                          {r.affiliate_url && <span class="pr-label">PR</span>}
                        </td>
                        <td>{r.price_note}</td>
                        <td>{r.ships_ja}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        ))}
      </section>

      <section class="section">
        <SectionTitle icon="plane" en="HOW TO BUY">買い方は4通り</SectionTitle>
        <ol class="steps">
          <li><strong>本人・メーカーの公式ストアから直接買う</strong>：いちばん確実です。支払いは米ドルなどの外貨で、クレジットカードかPayPalが一般的です。</li>
          <li><strong>海外の楽器店で買う</strong>：日本へ発送してくれる店を選びます。発送の可否は購入画面の配送先で日本を選べるかで確認できます。</li>
          <li><strong>Reverb（楽器専門のマーケット）で買う</strong>：新品・中古の出品が世界中から集まります。出品ごとに日本への発送の可否と送料が違うので、出品者の評価とあわせて確認しましょう。</li>
          <li><strong>日本に発送しない店は転送サービスを使う</strong>：海外の住所を借りて、そこから日本へ送り直してもらう方法です。手数料と送料が別にかかり、ギターのような大きな荷物は高くなりがちです。</li>
        </ol>
      </section>

      <section class="section">
        <SectionTitle icon="check" en="TAX">関税・消費税のめやす</SectionTitle>
        <ul>
          <li><strong>楽器は関税がかかりません</strong>：ギターなどの弦楽器（関税率表の92類）は関税が無税です。CD・Blu-ray・書籍も無税です。<SourceLink url="https://www.customs.go.jp/tetsuzuki/c-answer/imtsukan/1204_jr.htm" label="公式" /></li>
          <li><strong>消費税はかかります</strong>：自分で使うために買う場合、税金の計算に使う金額（課税価格）は「海外での販売価格 × 0.6」です。<SourceLink url="https://www.customs.go.jp/tetsuzuki/c-answer/imtsukan/1405_jr.htm" label="公式" /></li>
          <li><strong>課税価格の合計が1万円以下なら免税</strong>：ピックやTシャツなど少額の買い物は、多くの場合税金がかかりません（一部の品目は対象外）。<SourceLink url="https://www.customs.go.jp/tetsuzuki/c-answer/imtsukan/1006_jr.htm" label="公式" /></li>
        </ul>
        <div class="calc">
          <p class="calc-title">計算例：{yen(examplePriceUsd)}ドルのギターを買った場合（1ドル={RATE}円で計算）</p>
          <p>販売価格 {yen(exampleYen)}円 × 0.6 ＝ 課税価格 {yen(exampleTaxable)}円<br />消費税（10%）＝ 約{yen(exampleTax)}円 ＋ 配送業者の立替手数料</p>
          <p class="muted">「関税込み配送（DDP）」と書かれている店は、この税金を購入時にまとめて払う方式です。到着時に追加で払う必要は基本的にありません。実際の税額は税関が決めるため、ここでの金額は目安です。</p>
        </div>
      </section>

      <section class="section">
        <SectionTitle icon="bell" en="CHECK">買う前にチェック</SectionTitle>
        <ul>
          <li><strong>電源</strong>：ワウなどのペダルは日本で売っている9Vアダプターが使えるか確認します。アンプは海外仕様（120Vや230V）だと日本の100Vでは変圧器が必要です。</li>
          <li><strong>保証・修理</strong>：海外で買った製品は、日本の代理店の保証対象外になることがあります。</li>
          <li><strong>返品</strong>：海外への返品は送料が高くつきます。サイズや仕様は購入前によく確認しましょう。</li>
          <li><strong>偽物・転売</strong>：本人のサイン入りやステージ使用品は、公式ストアから買うのが安心です。</li>
        </ul>
      </section>
    </>
  )}
  <AdSlot />
</Base>

<style>
  .pr-note { font-size: 13px; color: var(--muted); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
  .pr-label { display: inline-block; font-size: 11px; font-weight: 700; color: #0b0b0f; background: var(--accent); border-radius: 4px; padding: 0 6px; margin: 0 6px 0 0; }
  .shop-group { margin-bottom: 24px; }
  .steps li, .section ul li { margin-bottom: 8px; }
  .calc { border-left: 4px solid var(--accent); background: rgba(255, 255, 255, 0.04); padding: 12px 16px; margin-top: 16px; }
  .calc-title { font-weight: 700; margin: 0 0 6px; }
</style>
